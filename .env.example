# Botkeep / local environment
# Copy to .env for local runs; on Botkeep set these as service variables.

# Google OAuth client used for the Antigravity login.
# Create an OAuth "Web application" client in Google Cloud Console and add
# https://YOUR-DOMAIN/api/auth/antigravity/callback as an authorized redirect URI.
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=

# Must match the redirect URI registered above, exactly. Set it explicitly on
# any host behind a proxy so the callback never falls back to an internal host.
ANTIGRAVITY_CALLBACK_URL=https://YOUR-DOMAIN/api/auth/antigravity/callback

# Friendly ids are expanded automatically:
#   gemini-3.8-flash -> gemini-3.8-flash-medium(medium)
# An upstream preset string is also accepted verbatim.
ANTIGRAVITY_MODEL=gemini-3.8-flash

# Comma-separated accounts allowed to log in. Empty = any Google account that
# finishes consent. Google cannot restrict a published OAuth client, so this is
# the actual account gate.
ANTIGRAVITY_ALLOWED_EMAILS=

# Persistent volume for the refreshable login (antigravity.json lives here).
DATA_DIR=./data

PORT=3000
