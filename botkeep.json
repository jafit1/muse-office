{
  "name": "gembul-agent",
  "description": "Gembul Agent — Antigravity-powered animated agent office",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --omit=dev"
  },
  "start": {
    "command": "npm start"
  },
  "healthcheck": {
    "path": "/health",
    "intervalSeconds": 30,
    "timeoutSeconds": 5
  },
  "resources": {
    "memoryMb": 1537,
    "cpu": 1,
    "storageMb": 1024
  }
}
